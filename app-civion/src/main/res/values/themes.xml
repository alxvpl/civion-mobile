<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <style name="Theme.Civion.Startup" parent="Theme2.Main.Startup" />

    <style name="Theme.Civion.Light" parent="Theme2.Thunderbird.Light">
        <!-- CIVION accent: Deep Violet. Used sparingly: selection, primary action, CIVION actions. -->
        <item name="colorPrimary">#6E56CF</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#7A62DA</item>
        <item name="colorOnPrimaryContainer">#FFFFFF</item>
        <item name="colorPrimaryInverse">#C8BAFF</item>
        <!-- The fixed primary roles carry the same accent: text selection (textColorHighlight) is one of them. -->
        <item name="colorPrimaryFixed">#E7DFFF</item>
        <item name="colorOnPrimaryFixed">#200E5E</item>
        <item name="colorPrimaryFixedDim">#C8BAFF</item>
        <item name="colorOnPrimaryFixedVariant">#5A45B2</item>

        <!-- CIVION neutrals, the same values as civionLightColorScheme in CivionBoltTheme.kt, so the
             classic screens - the message list above all - sit on the surfaces the Compose screens
             sit on. Secondary is neutral there too, so a selected or active row is grey, not blue. -->
        <item name="colorSecondary">#4A4749</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#6E696B</item>
        <item name="colorOnSecondaryContainer">#FFFFFF</item>
        <item name="colorSurfaceDim">#DDD9D8</item>
        <item name="colorSurface">#FCFAF9</item>
        <item name="colorSurfaceBright">#FCFAF9</item>
        <item name="colorOnSurface">#1B1A1A</item>
        <item name="colorOnSurfaceVariant">#3F4144</item>
        <item name="colorSurfaceContainerLowest">#FFFFFF</item>
        <item name="colorSurfaceContainerLow">#F6F4F3</item>
        <item name="colorSurfaceContainer">#F1EEEC</item>
        <item name="colorSurfaceContainerHigh">#EBE8E6</item>
        <item name="colorSurfaceContainerHighest">#E5E2E0</item>
        <item name="colorSurfaceVariant">#E5E2E0</item>
        <item name="colorSurfaceInverse">#302F2F</item>
        <item name="colorOnSurfaceInverse">#F3F0EF</item>
        <item name="colorOutline">#6E7074</item>
        <item name="colorOutlineVariant">#BFC1C4</item>
        <item name="android:colorBackground">#FCFAF9</item>

        <item name="actionModeCloseDrawable">@drawable/ic_close</item>
        <item name="actionBarPopupTheme">@style/Widget.App.ActionMode.PopupMenu</item>
        <item name="toolbarStyle">@style/Widget.App.Toolbar</item>

        <!-- A little less height than the platform default, so the header sits closer to the mail. -->
        <item name="actionBarSize">52dp</item>

        <!-- Legacy styles -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>

        <item name="iconStarColor">#fbbc04</item>

        <item name="textColorPrimaryRecipientDropdown">@android:color/primary_text_light</item>
        <item name="textColorSecondaryRecipientDropdown">@android:color/secondary_text_light</item>

        <item name="messageListSwipeSelectColor">@color/material_blue_600</item>
        <item name="messageListSwipeToggleReadColor">@color/material_blue_600</item>
        <item name="messageListSwipeToggleStarColor">@color/material_orange_600</item>
        <item name="messageListSwipeArchiveColor">@color/material_green_600</item>
        <item name="messageListSwipeDeleteColor">@color/material_red_600</item>
        <item name="messageListSwipeSpamColor">@color/material_red_700</item>
        <item name="messageListSwipeMoveColor">@color/material_purple_500</item>

        <item name="contactPictureFallbackDefaultBackgroundColor">#ffababab</item>
        <item name="contactPictureFallbackBackgroundColors">@array/contact_picture_fallback_background_colors_light</item>
        <item name="contactTokenBackgroundColor">#ccc</item>
        <item name="tintColorBulletPointPositive">#77aa22</item>
        <item name="tintColorBulletPointNegative">#dd2222</item>
        <item name="tintColorBulletPointNeutral">#888</item>

        <item name="openpgp_black">#000</item>
        <item name="openpgp_orange">#FF8800</item>
        <item name="openpgp_red">#CC0000</item>
        <item name="openpgp_green">#669900</item>
        <item name="openpgp_blue">#336699</item>
        <item name="openpgp_grey">#bbb</item>
        <item name="openpgp_dark_grey">#888</item>
    </style>

    <style name="Theme.Civion.Dark" parent="Theme2.Thunderbird.Dark">
        <!-- CIVION accent: Deep Violet, lightened for dark surfaces. -->
        <item name="colorPrimary">#C8BAFF</item>
        <item name="colorOnPrimary">#301C80</item>
        <item name="colorPrimaryContainer">#5A45B2</item>
        <item name="colorOnPrimaryContainer">#E7DFFF</item>
        <item name="colorPrimaryInverse">#6E56CF</item>
        <item name="colorPrimaryFixed">#E7DFFF</item>
        <item name="colorOnPrimaryFixed">#200E5E</item>
        <item name="colorPrimaryFixedDim">#C8BAFF</item>
        <item name="colorOnPrimaryFixedVariant">#5A45B2</item>

        <!-- CIVION neutrals, the same values as civionDarkColorScheme in CivionBoltTheme.kt: the
             graphite surfaces, lifted secondary text and visible separators the Compose screens have,
             now under the classic screens too. Secondary is neutral, so selection is grey, not blue. -->
        <item name="colorSecondary">#CFC8CA</item>
        <item name="colorOnSecondary">#322E30</item>
        <item name="colorSecondaryContainer">#4A4548</item>
        <item name="colorOnSecondaryContainer">#EDE5E7</item>
        <item name="colorSurfaceDim">#17181B</item>
        <item name="colorSurface">#1C1E21</item>
        <item name="colorSurfaceBright">#34373C</item>
        <item name="colorOnSurface">#EAE7E8</item>
        <item name="colorOnSurfaceVariant">#D2D3D8</item>
        <item name="colorSurfaceContainerLowest">#141619</item>
        <item name="colorSurfaceContainerLow">#212429</item>
        <item name="colorSurfaceContainer">#262A2F</item>
        <item name="colorSurfaceContainerHigh">#2E3238</item>
        <item name="colorSurfaceContainerHighest">#373C43</item>
        <item name="colorSurfaceVariant">#373C43</item>
        <item name="colorSurfaceInverse">#EAE7E8</item>
        <item name="colorOnSurfaceInverse">#303031</item>
        <item name="colorOutline">#A0A1A7</item>
        <item name="colorOutlineVariant">#56595E</item>
        <item name="android:colorBackground">#1C1E21</item>

        <item name="actionModeCloseDrawable">@drawable/ic_close</item>
        <item name="actionBarPopupTheme">@style/Widget.App.ActionMode.PopupMenu</item>
        <item name="toolbarStyle">@style/Widget.App.Toolbar</item>

        <!-- A little less height than the platform default, so the header sits closer to the mail. -->
        <item name="actionBarSize">52dp</item>

        <!-- Legacy styles -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>

        <item name="iconStarColor">#fdd663</item>

        <item name="textColorPrimaryRecipientDropdown">@android:color/primary_text_dark</item>
        <item name="textColorSecondaryRecipientDropdown">@android:color/secondary_text_dark</item>

        <item name="messageListSwipeSelectColor">@color/material_blue_700</item>
        <item name="messageListSwipeToggleReadColor">@color/material_blue_700</item>
        <item name="messageListSwipeToggleStarColor">@color/material_orange_700</item>
        <item name="messageListSwipeArchiveColor">@color/material_green_700</item>
        <item name="messageListSwipeDeleteColor">@color/material_red_700</item>
        <item name="messageListSwipeSpamColor">@color/material_red_800</item>
        <item name="messageListSwipeMoveColor">@color/material_purple_600</item>

        <item name="contactTokenBackgroundColor">#313131</item>
        <item name="contactPictureFallbackDefaultBackgroundColor">#ff606060</item>
        <item name="contactPictureFallbackBackgroundColors">@array/contact_picture_fallback_background_colors_dark</item>
        <item name="tintColorBulletPointPositive">#77aa22</item>
        <item name="tintColorBulletPointNegative">#dd2222</item>
        <item name="tintColorBulletPointNeutral">#bbb</item>

        <item name="openpgp_black">#fff</item>
        <item name="openpgp_orange">#ee7700</item>
        <item name="openpgp_red">#CC0000</item>
        <item name="openpgp_green">#77aa00</item>
        <item name="openpgp_blue">#6699cc</item>
        <item name="openpgp_grey">#888</item>
        <item name="openpgp_dark_grey">#bbb</item>
    </style>

    <style name="Theme.Civion.Light.Dialog" parent="Theme.Civion.Light" />
    <style name="Theme.Civion.Dark.Dialog" parent="Theme.Civion.Dark" />

    <style name="Theme.Civion.Light.Dialog.Translucent" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>

        <item name="tintColorBulletPointPositive">#77aa22</item>
        <item name="tintColorBulletPointNegative">#dd2222</item>
        <item name="tintColorBulletPointNeutral">#bbb</item>
    </style>

    <style name="Theme.Civion.Dark.Dialog.Translucent" parent="Theme.Material3.Dark.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>

        <item name="tintColorBulletPointPositive">#77aa22</item>
        <item name="tintColorBulletPointNegative">#dd2222</item>
        <item name="tintColorBulletPointNeutral">#bbb</item>
    </style>

    <style name="Theme.Civion.DayNight" parent="Theme.Civion.Light" />
    <style name="Theme.Civion.DayNight.Dialog" parent="Theme.Civion.Light.Dialog" />
    <style name="Theme.Civion.DayNight.Dialog.Translucent" parent="Theme.Civion.Light.Dialog.Translucent" />
</resources>
