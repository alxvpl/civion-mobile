<?xml version="1.0" encoding="utf-8"?>
<!--
  CIVION Mobile launcher background layer.

  Flat white. The launcher artwork itself is the master PNG in mipmap-*/ic_launcher_foreground.png
  and carries its own gradients, gloss and shadows; the background exists only because an
  adaptive icon requires a separate layer behind the foreground, and a plain light ground is
  what lets the artwork's shading read.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#FFFFFF" />
</vector>
