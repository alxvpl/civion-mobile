<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Mail override of the message view container.

  A resource of this name in the application module wins over the one in legacy/ui/legacy. The
  view pager, its id and the TouchInterceptView around it are unchanged: that view exists to keep
  the pager from stealing gestures meant for the scroll view and the web view, and it only works
  while the pager is its child.

  What is added is a bottom action row carrying the two things a message is usually answered
  with. Reply and forward were reachable only from a popup behind the header, which is a tap and a
  read for the two most common actions on the screen. Reply all stays in that overflow: it is
  occasionally right and frequently wrong, and a permanent button for it invites the wrong one.
  Move and delete stay in the top bar, where destructive and filing actions belong - away from the
  thumb that is answering.

  The buttons are found by tag rather than by id. Ids generated in this module are not visible to
  the fragment, which lives in legacy/ui/legacy; a tag is a string and crosses that boundary.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    >

    <com.fsck.k9.ui.messageview.TouchInterceptView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        >

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/message_viewpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            />

    </com.fsck.k9.ui.messageview.TouchInterceptView>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        />

    <LinearLayout
        android:tag="civion_message_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerLow"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        >

        <com.google.android.material.button.MaterialButton
            android:tag="civion_action_reply"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/reply_action"
            app:icon="@drawable/ic_reply"
            app:iconGravity="textStart"
            />

        <com.google.android.material.button.MaterialButton
            android:tag="civion_action_forward"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/forward_action"
            app:icon="@drawable/ic_forward"
            app:iconGravity="textStart"
            />

    </LinearLayout>

</LinearLayout>
